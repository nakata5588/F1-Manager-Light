{
  "name": "f1-manager-light",
  "version": "1.0.1",
  "description": "Historical Formula 1 management game built with React, Vite and a JSON-backed simulation database.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "node scripts/convert-excel.mjs",
    "validate:data": "node scripts/validate_json.js",
    "check": "npm run test:career && npm run validate:data && npm run build",
    "dev:all": "npm-run-all -p dev watch:data",
    "watch:data": "chokidar \"data/**/*.xlsx\" -c \"npm run build:data\"",
    "predev": "node scripts/build-team-seasons.mjs",
    "prebuild": "node scripts/build-team-seasons.mjs",
    "test:career": "node --test tests/careerBoundary.test.js"
  },
  "keywords": [
    "f1",
    "manager",
    "simulation",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.17.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.34.0",
    "exceljs": "^4.4.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.3",
    "xlsx": "^0.18.5"
  },
  "type": "module"
}
